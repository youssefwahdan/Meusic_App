<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:motion="http://schemas.android.com/apk/res-auto"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent">
<androidx.constraintlayout.motion.widget.MotionLayout
    android:id="@+id/music_player_motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/activity_player_scene"
    motion:currentState="@id/start"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_constraint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

            <include layout="@layout/toolbar" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/create_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="8dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/add_image_container"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    motion:cardCornerRadius="8dp"
                    motion:layout_constraintTop_toTopOf="parent"
                    motion:layout_constraintBottom_toBottomOf="parent"
                    motion:layout_constraintStart_toStartOf="parent"
                    motion:cardBackgroundColor="@color/secondaryBackground"
                    >
                    <ImageView
                        android:id="@+id/add_image"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/primary"
                        android:layout_margin="5dp"
                        />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/create_playlist_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    motion:layout_constraintTop_toTopOf="@id/add_image_container"
                    motion:layout_constraintBottom_toBottomOf="@id/add_image_container"
                    motion:layout_constraintStart_toEndOf="@id/add_image_container"
                    motion:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="16dp"
                    android:text="Create Playlist"
                    />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    motion:dividerColor="@color/secondaryForeground"
                    motion:layout_constraintTop_toBottomOf="@id/create_playlist_txt"
                    motion:layout_constraintStart_toStartOf="@id/create_playlist_txt"
                    motion:layout_constraintEnd_toEndOf="@id/create_playlist_txt"
                    android:layout_marginTop="8dp"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlists_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/empty_playlists_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No playlists yet"
                android:textSize="18sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/activity_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"/>
</androidx.constraintlayout.motion.widget.MotionLayout>

</FrameLayout>

