<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp">
    <TextView
        android:id="@+id/confirmation_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you Sure?"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <Button
        android:id="@+id/confirmation_confirm_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/confirmation_message"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:text="confirm"
        android:textSize="12sp"
        android:textColor="@color/danger"
        android:background="@color/full_transparent"
        />
    <Button
        android:id="@+id/confirmation_cancel_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/confirmation_confirm_btn"
        app:layout_constraintBottom_toBottomOf="@id/confirmation_confirm_btn"
        app:layout_constraintEnd_toStartOf="@id/confirmation_confirm_btn"
        android:text="cancel"
        android:textSize="12sp"
        android:textColor="@color/secondaryForeground"
        android:background="@color/full_transparent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>