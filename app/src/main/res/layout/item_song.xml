<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000"
    android:paddingTop="6dp"
    android:paddingHorizontal="12dp">

    <!-- Album Art Placeholder (Red square) -->
<!--    <ImageView-->
<!--        android:id="@+id/song_art"-->
<!--        android:layout_width="48dp"-->
<!--        android:layout_height="48dp"-->
<!--        android:background="@color/brand_red"-->
<!--        android:src="@android:drawable/ic_media_play"-->
<!--        android:tint="#FFFFFF"-->
<!--        android:padding="10dp"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintTop_toTopOf="parent"-->
<!--        app:layout_constraintBottom_toBottomOf="parent"-->
<!--        android:contentDescription="Album Art" />-->

    <!-- Song Title -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/song_duration"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="6dp"
        android:id="@+id/constraint_box"
        >

        <TextView
            android:id="@+id/song_title"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryForeground"
            android:textSize="@dimen/text_size_subtitle"
            android:text="Hello"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <!-- Artist Name -->
        <TextView
            android:id="@+id/song_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/secondaryForeground"
            android:text="name"
            android:textSize="@dimen/text_size_caption"
            app:layout_constraintStart_toStartOf="@id/song_title"
            app:layout_constraintTop_toBottomOf="@id/song_title"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/song_artist"
            app:layout_constraintBottom_toBottomOf="@id/song_artist"
            app:layout_constraintStart_toEndOf="@id/song_artist"
            android:layout_marginStart="5dp"
            android:text="-"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/secondaryForeground"
            android:id="@+id/dash_sp"
            />
        <TextView
            android:id="@+id/album_name"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="5dp"
            android:text="album"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/secondaryForeground"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="@id/dash_sp"
            app:layout_constraintStart_toEndOf="@id/dash_sp"
            app:layout_constraintTop_toTopOf="@id/dash_sp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintVertical_bias="0.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Duration (e.g., 3:45) -->
    <TextView
        android:id="@+id/song_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/secondaryForeground"
        android:textSize="@dimen/text_size_caption"
        android:text="3:50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- Divider -->
    <View
        android:id="@+id/song_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#333333"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        />

</androidx.constraintlayout.widget.ConstraintLayout>