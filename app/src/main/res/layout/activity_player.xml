<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_player_View"
    tools:parentTag="androidx.constraintlayout.motion.widget.MotionLayout"
    >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/secondaryBackground"
        />
    <androidx.cardview.widget.CardView
        android:id="@+id/background_album_art_container"
        android:layout_height="0dp"
        android:layout_width="0dp"
        app:layout_constraintTop_toTopOf="@id/main_container"
        app:layout_constraintStart_toStartOf="@id/main_container"
        app:layout_constraintEnd_toEndOf="@id/main_container"
        app:layout_constraintBottom_toBottomOf="@id/main_container"
        app:cardElevation="0dp"
        >

        <ImageView
            android:id="@+id/background_album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="1"
            android:contentDescription="Background Album Art"
            />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/transparent_layer_container"
        app:cardElevation="0dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/main_container"
        app:layout_constraintBottom_toBottomOf="@id/main_container"
        app:layout_constraintStart_toStartOf="@id/main_container"
        app:layout_constraintEnd_toEndOf="@id/main_container"
        app:cardBackgroundColor="#00000000"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/transparent_layer"
            android:contentDescription="Transparent Layer"
            android:background="#60000000"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/art_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="30dp"
        app:layout_constraintBottom_toBottomOf="@id/main_container"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@id/main_container"
        app:layout_constraintStart_toStartOf="@id/main_container"
        app:layout_constraintTop_toTopOf="@id/main_container"
        app:layout_constraintVertical_bias="0.15"

        />



    <!-- 1. Album Art -->

    <androidx.cardview.widget.CardView
        android:id="@+id/album_art_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="@id/art_container"
        app:layout_constraintEnd_toEndOf="@id/art_container"
        app:layout_constraintStart_toStartOf="@id/art_container"
        app:layout_constraintTop_toTopOf="@id/art_container"
        >

        <ImageView
            android:id="@+id/album_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
 />
    </androidx.cardview.widget.CardView>

    <!-- 2. Song Title -->

    <TextView
        android:id="@+id/song_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Song Title"
        android:textColor="@color/primaryForeground"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/art_container"
        app:layout_constraintEnd_toEndOf="@id/art_container"
        app:layout_constraintTop_toBottomOf="@id/art_container"
        />

    <!-- 3. Artist Name -->
    <TextView
        android:id="@+id/song_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Artist Name"
        android:textColor="@color/gray_200"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/song_title"
        app:layout_constraintStart_toStartOf="@id/song_title"
        app:layout_constraintTop_toBottomOf="@id/song_title" />

    <!-- 4. Play/Pause Button -->
    <ImageView
        android:id="@+id/play_btn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="40dp"
        android:contentDescription="Play"
        android:src="@drawable/ic_play_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#FFFFFF" />

    <!-- 1. SeekBar -->
    <SeekBar
        android:id="@+id/seek_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/play_btn"
        app:layout_constraintEnd_toEndOf="@id/art_container"
        app:layout_constraintStart_toStartOf="@id/art_container"
        android:thumbTint="@color/primary"
        android:foregroundTint="@color/primaryBackground"
        android:progressBackgroundTint="@color/primaryForeground"
        android:progressTint="@color/primary"
        android:progress="30"
        />

    <!-- 2. Current Time -->
    <TextView
        android:id="@+id/current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/primaryForeground"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/seek_bar"
        app:layout_constraintTop_toBottomOf="@id/seek_bar" />

    <!-- 3. Total Time -->
    <TextView
        android:id="@+id/total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/primaryForeground"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/seek_bar"
        app:layout_constraintTop_toBottomOf="@id/seek_bar" />

    <!-- 5. Previous Button -->
    <ImageView
        android:id="@+id/prev_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Previous"
        android:src="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="@id/play_btn"
        app:layout_constraintEnd_toStartOf="@id/play_btn"
        app:layout_constraintTop_toTopOf="@id/play_btn"
        app:tint="#FFFFFF" />

    <!-- 6. Next Button -->
    <ImageView
        android:id="@+id/next_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:contentDescription="Next"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="@id/play_btn"
        app:layout_constraintStart_toEndOf="@id/play_btn"
        app:layout_constraintTop_toTopOf="@id/play_btn"
        app:tint="#FFFFFF" />

    <!-- 5. down Arrow -->

    <ImageView
        android:id="@+id/down_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="20dp"
        android:contentDescription="Down Close Button"
        android:rotation="180"
        android:src="@drawable/ic_keyboard_arrow_up"
        app:layout_constraintStart_toStartOf="@id/main_container"
        app:layout_constraintTop_toTopOf="@id/main_container"
        app:tint="@color/primaryForeground" />

</merge>