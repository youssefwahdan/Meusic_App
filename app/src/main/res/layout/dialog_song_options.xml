<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/favourite_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            >
            <ImageView
                android:id="@+id/favourite_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_favorite_border"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            <TextView
                android:id="@+id/favourite_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add to Favourite"
                app:layout_constraintStart_toEndOf="@id/favourite_icon"
                app:layout_constraintTop_toTopOf="@id/favourite_icon"
                app:layout_constraintBottom_toBottomOf="@id/favourite_icon"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                />
            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="1dp"
                app:layout_constraintTop_toBottomOf="@id/favourite_icon"
                android:layout_marginTop="8dp"
                android:background="@color/secondaryBackground"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/song_info_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"

            >
            <ImageView
                android:id="@+id/song_info_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info_outline"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />
            <TextView
                android:id="@+id/song_info_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song Info"
                app:layout_constraintStart_toEndOf="@id/song_info_icon"
                app:layout_constraintTop_toTopOf="@id/song_info_icon"
                app:layout_constraintBottom_toBottomOf="@id/song_info_icon"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</ScrollView>